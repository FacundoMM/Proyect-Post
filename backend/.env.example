# Conexion de la aplicacion. Usa el Session Pooler de Supabase (puerto 5432)
# o el Transaction Pooler (puerto 6543 con pgbouncer=true).
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Conexion directa para Prisma CLI/migraciones.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Puerto local opcional del backend
PORT=4000

# Storage de imagenes. La clave service role solo va en el backend/Heroku.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ey..."
SUPABASE_STORAGE_BUCKET="product-images"

# Verificacion del webhook. Puedes inventar un texto largo y guardarlo tambien en Meta.
WHATSAPP_VERIFY_TOKEN="cambia-este-token-de-verificacion"

# Se usaran para enviar respuestas despues de probar la recepcion.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
